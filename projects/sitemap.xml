---
layout: null
permalink: /projects/sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ "/projects/" | absolute_url }}</loc>
  </url>
  {%- for project in site.projects %}
  <url>
    <loc>{{ project.url | absolute_url }}</loc>
    {%- if project.last_modified_at or project.date %}
    <lastmod>{{ project.last_modified_at | default: project.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
  {%- endfor %}
</urlset>
